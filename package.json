    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cn": "^0.5.0",
    "husky": "^9.1.7",
    "lucide-react": "^1.61.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "terser": "^5.51.2",
